# --- Credentials (NEVER commit) ---------------------------------------------
.creds/
*.pem
*.key
.config/earthengine/

# Allow specific JSONs that are part of the repo
*.json
!configs/*.json
!dashboard/data/**/*.json
!data/reference/**/*.json
!.github/**/*.json

# --- Data: only reference panels + dashboard outputs are tracked ------------
data/raw/
data/interim/
data/processed/
data/external/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Environments -----------------------------------------------------------
.env
.venv/
venv/
env/

# --- Jupyter ----------------------------------------------------------------
.jupyter/

# --- IDE --------------------------------------------------------------------
.idea/
.vscode/
*.swp

# --- LaTeX build artifacts --------------------------------------------------
paper/_minted-*/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz
paper/*.zip

# --- Large derivative outputs (regenerated by pipeline) ---------------------
dashboard/data/tiles/
dashboard/data/_test_*
logs/*.log

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Pipeline tooling -------------------------------------------------------
.snakemake/
.dvc/cache/
.dvc/tmp/
